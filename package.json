{
  "name": "mc-clone",
  "private": true,
  "version": "0.4.5",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "biome": "biome check --write",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "spec:check": "node --env-file-if-exists=.env scripts/spec/check.ts",
    "spec:test": "node --test 'scripts/spec/*.test.ts'",
    "start": "serve dist -s -n -L -p $PORT "
  },
  "dependencies": {
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@react-three/cannon": "^6.6.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.4",
    "chroma-js": "^3.2.0",
    "nanoid": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "serve": "^14.2.6",
    "tailwind-animations": "^1.0.2",
    "tailwindcss": "^4.3.4",
    "three": "^0.187.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/chroma-js": "^3.1.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "packageManager": "pnpm@12.15.0"
}
